# 示例：硅基流动。也可填写其他兼容 OpenAI API 的服务。
# BASE_URL 填服务的 API 根地址，不要追加 /chat/completions 或 /embeddings。
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V3.2

# 向量模型负责把文字转成数字，与上面的聊天模型是两回事。
# 即使使用同一平台，也请在这里填一次 Key；两个服务可独立更换。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# 以下参数可以先不改；路径相对于本项目目录。
DOCS_DIR=docs
DB_DIR=storage
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=3
